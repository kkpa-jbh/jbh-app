# Static file server for jbh-web (the built Ionic/Angular app).
# Magus's Caddy terminates HTTPS and proxies here over the Docker network "edge".
{
	# No admin API and no HTTPS here: this container is only reached by the edge proxy.
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode gzip

	# Angular puts a content hash in bundle names (main-ABCD1234.js), so they never change: cache for a year.
	# Everything else (index.html, assets) is revalidated, so a new deploy shows up at once.
	@hashed path_regexp -[A-Z0-9]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@notHashed not path_regexp -[A-Z0-9]{8}\.(js|css)$
	header @notHashed Cache-Control "no-cache"

	# Single-page app: unknown paths serve index.html, and the Angular router takes over.
	try_files {path} /index.html
	file_server
}
